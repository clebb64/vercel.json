{
  "version": 2,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "https://143.14.244.242:443/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Host", "value": "143.14.244.242" },
        { "key": "X-Forwarded-For", "value": "143.14.244.242" },
        { "key": "Connection", "value": "upgrade" },
        { "key": "Upgrade", "value": "websocket" }
      ]
    }
  ]
}
